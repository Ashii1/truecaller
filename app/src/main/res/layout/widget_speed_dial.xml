<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_speed_dial_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- Top Bar: App Title and Open Dialer button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_vigilshield"
            android:contentDescription="VigilShield" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="VigilShield Speed Dial"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_open_dialer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open Dialer"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

    <!-- Speed Dial Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <!-- Slot 1: Mom / Family -->
        <LinearLayout
            android:id="@+id/slot_contact_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/slot_avatar_1"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_circle_btn"
                android:gravity="center"
                android:text="M"
                android:textColor="#38BDF8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/slot_name_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Mom"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Slot 2: Work / Partner -->
        <LinearLayout
            android:id="@+id/slot_contact_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/slot_avatar_2"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_circle_btn"
                android:gravity="center"
                android:text="W"
                android:textColor="#34D399"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/slot_name_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Work"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Slot 3: Emergency / Doctor -->
        <LinearLayout
            android:id="@+id/slot_contact_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/slot_avatar_3"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_circle_btn"
                android:gravity="center"
                android:text="SOS"
                android:textColor="#F87171"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/slot_name_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Emergency"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Slot 4: Voicemail / Recents -->
        <LinearLayout
            android:id="@+id/slot_contact_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/slot_avatar_4"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_circle_btn"
                android:gravity="center"
                android:text="VM"
                android:textColor="#FBBF24"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/slot_name_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Voicemail"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:singleLine="true" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
